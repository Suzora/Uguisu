{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo deny:*)",
      "Bash(python3 scripts/check.py:*)",
      "Bash(python3 scripts/smoke.py:*)",
      "Bash(python3 scripts/check-doc-links.py:*)"
    ],
    "deny": [
    ]
  }
}
