t Steps:</b></p><ul><li><a href='https://www.buzzsprout.com/blog/submit-apple-podcasts'>Submit your Show to Apple Podcasts</a> (Blog) </li><li><a href='https://www.buzzsprout.com/blog/submit-podcast-spotify'>Submit your Show to Spotify</a> (Blog)</li><li><a href='https://www.buzzsprout.com/blog/submit-google-podcasts'>Submit your show to Google Podcasts</a> (Blog)</li><li><a href='https://podcastindex.org/add'>Submit your show to the Podcast Index</a> (Submission Form)</li></ul>]]></content:encoded>\n    <enclosure url=\"https://dts.podtrac.com/redirect.mp3/www.buzzsprout.com/1/episodes/10166258-podcast-directories-apple-spotify-and-google-podcasts.mp3\" length=\"14763020\" type=\"audio/mpeg\" />\n    <itunes:author>Buzzsprout</itunes:author>\n    <guid isPermaLink=\"false\">Buzzsprout-10166258</guid>\n    <pubDate>Tue, 09 Jan 2024 00:00:00 -0500</pubDate>\n    <podcast:transcript url=\"https://www.buzzsprout.com/1/10166258/transcript\" type=\"text/html\" />\n    <podcast:transcript url=\"https://www.buzzsprout.com/1/10166258/transcript.json\" type=\"application/json\" />\n    <podcast:transcript url=\"https://www.buzzsprout.com/1/10166258/transcript.srt\" type=\"application/x-subrip\" />\n    <podcast:transcript url=\"https://www.buzzsprout.com/1/10166258/transcript.vtt\" type=\"text/vtt\" />\n    <podcast:chapters url=\"https://www.buzzsprout.com/1/10166258/chapters.json\" type=\"application/json\" />\n    <psc:chapters>\n  <psc:chapter start=\"0:00\" title=\"It&#39;s like a phone book...\" />\n  <psc:chapter start=\"0:30\" title=\"What is a podcast directory?\" />\n  <psc:chapter start=\"4:48\" title=\"Apple Podcasts\" />\n  <psc:chapter start=\"10:20\" title=\"Spotify\" />\n  <psc:chapter start=\"12:34\" title=\"Google Podcasts\" />\n  <psc:chapter start=\"13:44\" title=\"Podcast Index\" />\n  <psc:chapter start=\"15:18\" title=\"Other Directories\" />\n  <psc:chapter start=\"19:00\" title=\"Next steps\" />\n</psc:chapters>\n    <itunes:duration>1228</itunes:dur