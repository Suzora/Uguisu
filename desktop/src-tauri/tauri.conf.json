{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uguisu",
  "identifier": "io.github.suzora.Uguisu",
  "build": {},
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "category": "Music",
    "shortDescription": "Self-hosted podcast archiver",
    "longDescription": "Uguisu, a podcast downloader and archive manager by Suzora, subscribes to podcast feeds, downloads their episodes and keeps them in a plain, verifiable archive on disk that you own. The desktop application runs the same server and the same interface as the standalone binary, on a private loopback port.",
    "copyright": "Suzora contributors",
    "publisher": "Suzora",
    "homepage": "https://github.com/suzora/uguisu",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0",
          "libglib2.0-0t64 | libglib2.0-0",
          "libgdk-pixbuf-2.0-0",
          "libcairo2",
          "libdbus-1-3",
          "ca-certificates"
        ],
        "section": "sound"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libsoup3",
          "glib2",
          "gdk-pixbuf2",
          "cairo",
          "dbus-libs",
          "libayatana-appindicator-gtk3",
          "ca-certificates"
        ],
        "epoch": 0
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "fragmentPaths": ["windows/login-item.wxs"],
        "componentGroupRefs": ["LoginItemCleanup"]
      },
      "allowDowngrades": false
    },
    "resources": {
      "../../web/dist": "web"
    },
    "useLocalToolsDir": true
  }
}
